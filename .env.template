# =============================================================================
# ATELIER DATABASE - CONNECTION CONFIGURATION
# =============================================================================
# 
# ИНСТРУКЦИЯ:
# 1. Скопируйте этот файл и назовите его просто ".env" (без .example)
# 2. Измените значения в соответствии с вашей конфигурацией SQL Server
# 3. НЕ добавляйте .env в систему контроля версий (git)!
#
# =============================================================================

# -----------------------------------------------------------------------------
# SQL SERVER CONNECTION
# -----------------------------------------------------------------------------

# Имя вашего SQL Server
# Примеры:
#   - localhost              (локальный сервер по умолчанию)
#   - .\SQLEXPRESS          (SQL Server Express)
#   - SERVER_NAME\INSTANCE  (именованный экземпляр)
#   - 192.168.1.100         (удаленный сервер по IP)
DB_SERVER=localhost

# Имя базы данных
DB_NAME=Atelier

# ODBC Driver (обычно не требует изменений)
# Проверить установленные драйверы: Get-OdbcDriver в PowerShell
DB_DRIVER=ODBC Driver 17 for SQL Server

# -----------------------------------------------------------------------------
# USER CREDENTIALS
# -----------------------------------------------------------------------------
# Учетные данные пользователей из скриптов создания БД
# ВАЖНО: Используйте те же пароли, что указали при создании логинов в SQL

# Администратор БД (полные права)
ADMIN_USER=atelier_admin
ADMIN_PASSWORD=Admin@2025!Strong

# Менеджер (чтение/запись данных)
MANAGER_USER=manager
MANAGER_PASSWORD=Manager@2025!Pass

# Закройщик (ограниченный доступ к заказам)
TAILOR_USER=tailor_user
TAILOR_PASSWORD=Tailor@2025!Pass

# Кассир (доступ к кассе, видит маскированные данные)
CASHIER_USER=cashier
CASHIER_PASSWORD=Cashier@2025!Pass

# =============================================================================
# ПРИМЕЧАНИЯ:
# =============================================================================
#
# 1. БЕЗОПАСНОСТЬ:
#    • Никогда не публикуйте этот файл с реальными паролями
#    • .env должен быть в .gitignore
#    • Используйте сильные пароли в production
#
# 2. ТЕСТИРОВАНИЕ ПОДКЛЮЧЕНИЯ:
#    python database.py
#
# 3. УСТРАНЕНИЕ ПРОБЛЕМ:
#    • Проверьте, что SQL Server запущен
#    • Убедитесь, что БД Atelier существует
#    • Проверьте правильность имени сервера
#    • Убедитесь, что ODBC Driver 17 установлен
#
# 4. АЛЬТЕРНАТИВНЫЕ ВАРИАНТЫ DB_SERVER:
#    # Локальный SQL Server Express:
#    DB_SERVER=.\SQLEXPRESS
#    
#    # Удаленный сервер:
#    DB_SERVER=192.168.1.100
#    
#    # Именованный экземпляр:
#    DB_SERVER=MYCOMPUTER\SQLINSTANCE
#
# =============================================================================
